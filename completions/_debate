#compdef debate
# zsh completion for debate CLI

_debate() {
  local -a cmds modes targets log_subs
  cmds=(
    'start:토론 세션 시작'
    'stop:세션 종료 (dir 보존)'
    'attach:실행 중인 세션에 attach'
    'focus:특정 pane 으로 focus 이동'
    'menu:자주 쓰는 명령 메뉴 팝업'
    'menu-auto:Stop hook 시 메뉴 자동 팝업 on/off'
    'install-hooks:HITL focus hook 설치 (claude/cursor)'
    'uninstall-hooks:hook 제거'
    'hooks-status:hook 설치 상태'
    'doctor:의존성 + hooks 점검'
    'tell:pane 에 메시지 입력'
    'hear:pane 출력 캡처'
    'shout:양쪽 토론자 동시 지시 (--all 시 arbiter 포함)'
    'verdict:a+b 출력을 모아 arbiter 에 판정 요청'
    'relay:출력을 상대 pane 에 전달'
    'relay-sum:화자에게 요약 시킨 뒤 전달'
    'round:N 라운드 자동 릴레이'
    'pick:mode 를 메뉴로 선택 후 relay'
    'save:current 세션을 이름으로 저장'
    'list:저장된 세션 목록'
    'show:세션 메타+로그 미리보기'
    'resume:저장된 세션 복원'
    'fork:세션을 분기 복원'
    'forget:세션 삭제'
    'export:세션 tarball 내보내기'
    'log:로그 보기/관리'
    'help:도움말'
  )

  # 저장된 세션 이름 후보
  _debate_sessions() {
    local sdir="${DEBATE_SESSIONS_DIR:-$HOME/.debate/sessions}"
    [ -d "$sdir" ] || return
    local -a names
    names=("${(@f)$(ls -1 "$sdir" 2>/dev/null)}")
    [ ${#names} -gt 0 ] && _describe -t sessions 'session' names
  }
  modes=(
    'rebut:반론 (기본)'
    'review:코드 관점 검토·약점 지적'
    'agree:동의+보완할 점'
    'extend:가설 발전·증거 보강'
    'question:날카로운 질문 3개'
    'judge:중립 판정'
  )
  targets=(a b arbiter moderator)
  log_subs=(path tail clear)

  if (( CURRENT == 2 )); then
    _describe -t commands 'debate command' cmds
    return
  fi

  case ${words[2]} in
    tell)
      (( CURRENT == 3 )) && _describe -t targets 'pane' targets
      ;;
    hear)
      (( CURRENT == 3 )) && _describe -t targets 'pane' targets
      (( CURRENT == 4 )) && _message 'lines (e.g. 30)'
      ;;
    relay|relay-sum)
      case $CURRENT in
        3|4) _describe -t targets 'pane' targets ;;
        5)   _describe -t modes 'mode' modes ;;
        6)   _message 'lines or wait_sec' ;;
      esac
      ;;
    round)
      case $CURRENT in
        3) _message 'round count (e.g. 3)' ;;
        4) _describe -t modes 'mode' modes ;;
        5) _message 'wait seconds (e.g. 15)' ;;
        6) compadd -- --sum ;;
      esac
      ;;
    pick)
      (( CURRENT == 3 || CURRENT == 4 )) && _describe -t targets 'pane' targets
      ;;
    log)
      (( CURRENT == 3 )) && compadd -- "${log_subs[@]}"
      ;;
    start)
      (( CURRENT == 3 )) && _path_files -/
      ;;
    show|resume|fork|forget|rm|export|attach|stop)
      (( CURRENT == 3 )) && _debate_sessions
      ;;
    focus)
      (( CURRENT == 3 )) && compadd -- a b arbiter moderator
      ;;
    menu-auto)
      (( CURRENT == 3 )) && compadd -- on off status
      ;;
  esac
}

_debate "$@"
