#compdef debate
# zsh completion for debate CLI

_debate() {
  local -a cmds modes targets log_subs
  cmds=(
    'start:토론 세션 시작'
    'stop:세션 종료'
    'doctor:의존성 점검'
    'tell:pane 에 메시지 입력'
    'hear:pane 출력 캡처'
    'shout:양쪽 토론자 동시 지시 (--all 시 arbiter 포함)'
    'verdict:claude+cursor 출력을 모아 arbiter 에 판정 요청'
    'relay:출력을 상대 pane 에 전달'
    'relay-sum:화자에게 요약 시킨 뒤 전달'
    'round:N 라운드 자동 릴레이'
    'pick:mode 를 메뉴로 선택 후 relay'
    'log:로그 보기/관리'
    'help:도움말'
  )
  modes=(
    'rebut:반론 (기본)'
    'review:코드 관점 검토·약점 지적'
    'agree:동의+보완할 점'
    'extend:가설 발전·증거 보강'
    'question:날카로운 질문 3개'
    'judge:중립 판정'
  )
  targets=(a b arbiter moderator)
  log_subs=(path tail clear)

  if (( CURRENT == 2 )); then
    _describe -t commands 'debate command' cmds
    return
  fi

  case ${words[2]} in
    tell)
      (( CURRENT == 3 )) && _describe -t targets 'pane' targets
      ;;
    hear)
      (( CURRENT == 3 )) && _describe -t targets 'pane' targets
      (( CURRENT == 4 )) && _message 'lines (e.g. 30)'
      ;;
    relay|relay-sum)
      case $CURRENT in
        3|4) _describe -t targets 'pane' targets ;;
        5)   _describe -t modes 'mode' modes ;;
        6)   _message 'lines or wait_sec' ;;
      esac
      ;;
    round)
      case $CURRENT in
        3) _message 'round count (e.g. 3)' ;;
        4) _describe -t modes 'mode' modes ;;
        5) _message 'wait seconds (e.g. 15)' ;;
        6) compadd -- --sum ;;
      esac
      ;;
    pick)
      (( CURRENT == 3 || CURRENT == 4 )) && _describe -t targets 'pane' targets
      ;;
    log)
      (( CURRENT == 3 )) && compadd -- "${log_subs[@]}"
      ;;
    start)
      (( CURRENT == 3 )) && _path_files -/
      ;;
  esac
}

_debate "$@"
