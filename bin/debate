#!/usr/bin/env bash
# debate — Claude Code × Cursor Agent debate CLI
# 단일 실행파일. tmux + smux(tmux-bridge) 필요.
set -e

DEBATE_LOG="${DEBATE_LOG:-$HOME/.debate/log-$(date +%Y%m%d).md}"
ARBITER_CMD="${DEBATE_ARBITER_CMD:-claude}"
A_CMD_DEFAULT="${DEBATE_A_CMD:-claude}"
B_CMD_DEFAULT="${DEBATE_B_CMD:-cursor}"
SESSIONS_DIR="${DEBATE_SESSIONS_DIR:-$HOME/.debate/sessions}"
AUTO_KEEP="${DEBATE_AUTO_KEEP:-10}"
ACTIVE_FILE="$HOME/.debate/active"
SELF="$0"

# 세션 id 자동 생성 (debate-<8자리>)
_gen_session_id() {
  echo "debate-$(uuidgen | tr 'A-Z' 'a-z' | cut -c1-8)"
}

# 현재 명령이 사용할 세션 id 결정
# 우선순위: DEBATE_SESSION 환경변수 > 현재 tmux 세션($TMUX) > ~/.debate/active
_resolve_session() {
  if [ -n "${DEBATE_SESSION:-}" ]; then
    echo "$DEBATE_SESSION"; return 0
  fi
  if [ -n "${TMUX:-}" ]; then
    local cur
    cur=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    case "$cur" in
      debate-*) echo "$cur"; return 0 ;;
    esac
  fi
  if [ -f "$ACTIVE_FILE" ]; then
    cat "$ACTIVE_FILE"; return 0
  fi
  return 1
}

_set_active() {
  mkdir -p "$(dirname "$ACTIVE_FILE")"
  echo "$1" > "$ACTIVE_FILE"
}

# tmux key bindings: prefix + a/b/r/m 으로 pane focus 이동
_install_keybindings() {
  local debate_path
  debate_path=$(command -v debate 2>/dev/null) || debate_path="$SELF"
  tmux bind-key a run-shell "'$debate_path' focus a"        2>/dev/null || true
  tmux bind-key b run-shell "'$debate_path' focus b"        2>/dev/null || true
  tmux bind-key r run-shell "'$debate_path' focus arbiter"  2>/dev/null || true
  tmux bind-key m run-shell "'$debate_path' focus moderator" 2>/dev/null || true
}

# 사용자 친화적 alias 를 실제 실행 명령으로 변환
_resolve_cmd() {
  case "$1" in
    cursor) echo "agent" ;;
    *)      echo "$1" ;;
  esac
}

# label 이 우리가 session-id 를 통제할 수 있는 CLI 인지
_supports_session() {
  case "$1" in
    claude|cursor) return 0 ;;
    *)             return 1 ;;
  esac
}

# session id 발급 (label 별)
_issue_session_id() {
  local label="$1"
  case "$label" in
    claude) uuidgen | tr 'A-Z' 'a-z' ;;
    cursor) agent create-chat 2>/dev/null ;;
    *)      echo "" ;;
  esac
}

# 신규 세션으로 시작할 때의 명령 (id 를 PIN)
_build_start_cmd() {
  local label="$1"; local sid="$2"
  case "$label" in
    claude) [ -n "$sid" ] && echo "claude --session-id $sid" || echo "claude" ;;
    cursor) [ -n "$sid" ] && echo "agent --resume $sid" || echo "agent" ;;
    *)      _resolve_cmd "$label" ;;
  esac
}

# 기존 세션을 이어서 시작할 때의 명령
_build_resume_cmd() {
  local label="$1"; local sid="$2"; local fork="${3:-0}"
  case "$label" in
    claude)
      if [ "$fork" = "1" ]; then
        echo "claude --resume $sid --fork-session"
      else
        echo "claude --resume $sid"
      fi
      ;;
    cursor) echo "agent --resume $sid" ;;
    *)      _resolve_cmd "$label" ;;
  esac
}

# 메타데이터 쓰기 (shell-source 가능한 flat 포맷)
_save_meta() {
  local dir="$1"
  mkdir -p "$dir"
  cat > "$dir/meta" <<EOF
NAME=$(printf '%q' "${META_NAME:-current}")
CREATED=$(printf '%q' "$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S)")
PROJECT_DIR=$(printf '%q' "$META_PROJECT_DIR")
A_LABEL=$(printf '%q' "$META_A_LABEL")
A_SESSION_ID=$(printf '%q' "$META_A_SESSION_ID")
B_LABEL=$(printf '%q' "$META_B_LABEL")
B_SESSION_ID=$(printf '%q' "$META_B_SESSION_ID")
ARBITER_LABEL=$(printf '%q' "$META_ARBITER_LABEL")
ARBITER_SESSION_ID=$(printf '%q' "$META_ARBITER_SESSION_ID")
TOPIC=$(printf '%q' "${META_TOPIC:-}")
EOF
}

# 메타데이터 읽기 → META_* 변수에 로드
_load_meta() {
  local dir="$1"
  [ -f "$dir/meta" ] || { echo "[!] no meta in $dir" >&2; return 1; }
  # shellcheck disable=SC1090
  set -a
  NAME=""; CREATED=""; PROJECT_DIR=""; TOPIC=""
  A_LABEL=""; A_SESSION_ID=""
  B_LABEL=""; B_SESSION_ID=""
  ARBITER_LABEL=""; ARBITER_SESSION_ID=""
  source "$dir/meta"
  META_NAME="$NAME"
  META_CREATED="$CREATED"
  META_PROJECT_DIR="$PROJECT_DIR"
  META_TOPIC="$TOPIC"
  META_A_LABEL="$A_LABEL"; META_A_SESSION_ID="$A_SESSION_ID"
  META_B_LABEL="$B_LABEL"; META_B_SESSION_ID="$B_SESSION_ID"
  META_ARBITER_LABEL="$ARBITER_LABEL"; META_ARBITER_SESSION_ID="$ARBITER_SESSION_ID"
  set +a
}

# 회전: SESSIONS_DIR 의 모든 디렉토리 중 mtime 기준 AUTO_KEEP 개만 유지
# (사용자가 명시 --name 로 지정한 의미있는 세션은 보존, 자동 생성된 짧은 uuid 만 회전)
_rotate_autos() {
  [ -d "$SESSIONS_DIR" ] || return 0
  local olds
  olds=$(ls -1t "$SESSIONS_DIR" 2>/dev/null | grep -E '^debate-[0-9a-f]{8}$' | tail -n +$((AUTO_KEEP + 1)))
  [ -z "$olds" ] && return 0
  while IFS= read -r d; do
    [ -n "$d" ] && rm -rf "$SESSIONS_DIR/$d"
  done <<< "$olds"
}

# 4-pane 레이아웃 셋업 (pane ID 기반 — pane-base-index 영향 안 받음)
# usage: _setup_layout <session> <project_dir> <a_label> <a_cmd> <b_label> <b_cmd> <arb_label> <arb_cmd> [moderator_title]
_setup_layout() {
  local SESSION="$1"
  local project_dir="$2" a_label="$3" a_cmd="$4"
  local b_label="$5" b_cmd="$6"
  local arb_label="$7" arb_cmd="$8"
  local mod_title="${9:-MODERATOR}"

  tmux kill-session -t "$SESSION" 2>/dev/null || true

  local PANE_A PANE_MOD PANE_ARB PANE_B
  PANE_A=$(tmux new-session -d -s "$SESSION" -n main -c "$project_dir" -P -F '#{pane_id}')
  PANE_MOD=$(tmux split-window -v -t "$PANE_A" -l 15% -c "$project_dir" -P -F '#{pane_id}')
  PANE_ARB=$(tmux split-window -v -t "$PANE_A" -l 22% -c "$project_dir" -P -F '#{pane_id}')
  PANE_B=$(tmux  split-window -h -t "$PANE_A" -l 50% -c "$project_dir" -P -F '#{pane_id}')

  tmux set -t "$SESSION" pane-border-status top
  tmux set -t "$SESSION" pane-border-format '#{?pane_active,#[fg=cyan bold],#[bold]} #{pane_title} #[default]'

  sleep 0.3
  local IDX_A IDX_B IDX_ARB IDX_MOD
  IDX_A=$(tmux   display-message -p -t "$PANE_A"   '#{pane_index}')
  IDX_B=$(tmux   display-message -p -t "$PANE_B"   '#{pane_index}')
  IDX_ARB=$(tmux display-message -p -t "$PANE_ARB" '#{pane_index}')
  IDX_MOD=$(tmux display-message -p -t "$PANE_MOD" '#{pane_index}')
  tmux-bridge name "$IDX_A"   a         2>/dev/null || true
  tmux-bridge name "$IDX_B"   b         2>/dev/null || true
  tmux-bridge name "$IDX_ARB" arbiter   2>/dev/null || true
  tmux-bridge name "$IDX_MOD" moderator 2>/dev/null || true

  tmux select-pane -t "$PANE_A"   -T "A: $a_label"
  tmux select-pane -t "$PANE_B"   -T "B: $b_label"
  tmux select-pane -t "$PANE_ARB" -T "ARBITER: $arb_label"
  tmux select-pane -t "$PANE_MOD" -T "$mod_title"

  tmux send-keys -t "$PANE_A"   "$a_cmd"   Enter
  tmux send-keys -t "$PANE_B"   "$b_cmd"   Enter
  tmux send-keys -t "$PANE_ARB" "$arb_cmd" Enter
  tmux select-pane -t "$PANE_MOD"
}


# ─── 내부 유틸 ──────────────────────────────────────────

_log() {
  mkdir -p "$(dirname "$DEBATE_LOG")"
  {
    echo ""
    echo "## [$(date +%H:%M:%S)] $1"
    echo ""
    echo "$2"
  } >> "$DEBATE_LOG"
}

_send() {
  local target="$1"; shift
  tmux-bridge read "$target" 1 >/dev/null
  tmux-bridge type "$target" "$*"
  tmux-bridge read "$target" 1 >/dev/null
  tmux-bridge keys "$target" Enter
}

_prompt() {
  local mode="$1"; local from="$2"; local content="$3"
  case "$mode" in
    rebut)
      printf '상대방(%s)의 주장:\n%s\n\n이에 대해 근거를 들어 반론해.' "$from" "$content" ;;
    review)
      printf '상대방(%s)의 분석:\n%s\n\n이 분석을 코드 관점에서 검토하고 누락/오류/약점을 구체적으로 지적해.' "$from" "$content" ;;
    agree)
      printf '상대방(%s)의 의견:\n%s\n\n동의하는 부분과 보완해야 할 부분을 정리해.' "$from" "$content" ;;
    extend)
      printf '상대방(%s)의 가설:\n%s\n\n이 가설을 더 발전시키고 추가 증거를 코드에서 찾아.' "$from" "$content" ;;
    question)
      printf '상대방(%s)의 주장:\n%s\n\n명확하지 않은 부분에 대해 날카로운 질문 3개를 던져.' "$from" "$content" ;;
    judge)
      printf '아래 두 주장에 대해 중립적으로 판정하고 더 설득력 있는 쪽과 그 이유를 말해줘.\n\n%s' "$content" ;;
    *)
      printf '상대방(%s):\n%s' "$from" "$content" ;;
  esac
}

_require() {
  for c in "$@"; do
    command -v "$c" &>/dev/null || { echo "[!] required: $c" >&2; exit 1; }
  done
}

# ─── 서브커맨드 ─────────────────────────────────────────

cmd_start() {
  _require tmux tmux-bridge
  local project_dir=""
  local a_label="$A_CMD_DEFAULT"
  local b_label="$B_CMD_DEFAULT"
  local arbiter_label="$ARBITER_CMD"
  local topic=""
  local name=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --a)        a_label="$2"; shift 2 ;;
      --b)        b_label="$2"; shift 2 ;;
      --arbiter)  arbiter_label="$2"; shift 2 ;;
      --topic)    topic="$2"; shift 2 ;;
      --name)     name="$2"; shift 2 ;;
      -h|--help)  echo "usage: debate start [--a claude|cursor] [--b ...] [--arbiter ...] [--topic <text>] [--name <name>] [project_dir]"; return 0 ;;
      *)          project_dir="$1"; shift ;;
    esac
  done
  project_dir="${project_dir:-$(pwd)}"

  # 세션 id 결정 (--name 우선, 없으면 자동 uuid)
  local SESSION
  if [ -n "$name" ]; then
    SESSION="debate-$name"
  else
    SESSION=$(_gen_session_id)
  fi

  if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "[!] $SESSION 이 이미 실행 중입니다 — attach: tmux attach -t $SESSION"
    exit 1
  fi
  if [ -d "$SESSIONS_DIR/$SESSION" ]; then
    echo "[!] $SESSION dir 이미 존재 — 다른 --name 사용 또는 'debate forget $SESSION'"
    exit 1
  fi

  # 회전: 자동 생성 세션 중 오래된 것 정리
  _rotate_autos

  echo "[*] session: $SESSION"
  echo "[*] session id 발급 중..."
  local a_sid b_sid arb_sid
  a_sid=$(_issue_session_id "$a_label")
  b_sid=$(_issue_session_id "$b_label")
  arb_sid=$(_issue_session_id "$arbiter_label")
  echo "    A ($a_label):       ${a_sid:-(unsupported)}"
  echo "    B ($b_label):       ${b_sid:-(unsupported)}"
  echo "    arbiter ($arbiter_label): ${arb_sid:-(unsupported)}"

  local a_cmd b_cmd arbiter_cmd
  a_cmd=$(_build_start_cmd "$a_label" "$a_sid")
  b_cmd=$(_build_start_cmd "$b_label" "$b_sid")
  arbiter_cmd=$(_build_start_cmd "$arbiter_label" "$arb_sid")

  META_NAME="$SESSION"
  META_PROJECT_DIR="$project_dir"
  META_A_LABEL="$a_label"; META_A_SESSION_ID="$a_sid"
  META_B_LABEL="$b_label"; META_B_SESSION_ID="$b_sid"
  META_ARBITER_LABEL="$arbiter_label"; META_ARBITER_SESSION_ID="$arb_sid"
  META_TOPIC="$topic"
  _save_meta "$SESSIONS_DIR/$SESSION"

  _set_active "$SESSION"

  _setup_layout "$SESSION" "$project_dir" "$a_label" "$a_cmd" "$b_label" "$b_cmd" "$arbiter_label" "$arbiter_cmd" "MODERATOR — $SESSION"
  _install_keybindings
  _log "start" "session=$SESSION a=$a_label/$a_sid b=$b_label/$b_sid arbiter=$arbiter_label/$arb_sid topic=$topic"
  tmux attach -t "$SESSION"
}

cmd_stop() {
  local SESSION
  SESSION="${1:-$(_resolve_session 2>/dev/null || true)}"
  if [ -z "$SESSION" ]; then
    echo "[!] 활성 세션 없음 — debate ls 로 확인 후 'debate stop <name>' 또는 DEBATE_SESSION=... 사용"
    exit 1
  fi
  # scrollback 캡처
  if [ -d "$SESSIONS_DIR/$SESSION" ] && tmux has-session -t "$SESSION" 2>/dev/null; then
    for p in a b arbiter; do
      tmux-bridge read "$p" 500 > "$SESSIONS_DIR/$SESSION/${p}.scrollback.txt" 2>/dev/null || true
    done
  fi
  tmux kill-session -t "$SESSION" 2>/dev/null && echo "stopped: $SESSION" || echo "no tmux session: $SESSION"
  # active 가 이 세션이면 클리어
  if [ -f "$ACTIVE_FILE" ] && [ "$(cat "$ACTIVE_FILE")" = "$SESSION" ]; then
    rm -f "$ACTIVE_FILE"
  fi
  _rotate_autos
}

# ─── 세션 저장/관리 ─────────────────────────────────────

cmd_save() {
  local new="${1:-}"
  [ -z "$new" ] && { echo "usage: debate save <new-name>"; exit 1; }
  local SESSION
  SESSION=$(_resolve_session 2>/dev/null) || { echo "[!] 활성 세션 없음"; exit 1; }
  local new_id="debate-$new"
  [ "$SESSION" = "$new_id" ] && { echo "[!] 이미 같은 이름"; exit 0; }
  [ -d "$SESSIONS_DIR/$new_id" ] && { echo "[!] $new_id 이미 존재"; exit 1; }
  if tmux has-session -t "$new_id" 2>/dev/null; then
    echo "[!] $new_id tmux 세션 이미 실행 중"; exit 1
  fi
  # dir rename
  mv "$SESSIONS_DIR/$SESSION" "$SESSIONS_DIR/$new_id"
  # meta NAME 갱신
  _load_meta "$SESSIONS_DIR/$new_id"
  META_NAME="$new_id"
  _save_meta "$SESSIONS_DIR/$new_id"
  # tmux session rename (살아있으면)
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux rename-session -t "$SESSION" "$new_id" 2>/dev/null || true
    # moderator 타이틀 갱신 — 베스트 에포트
    tmux list-panes -t "$new_id" -F '#{pane_id} #{pane_title}' 2>/dev/null | while read -r pid title; do
      case "$title" in
        MODERATOR*) tmux select-pane -t "$pid" -T "MODERATOR — $new_id" ;;
      esac
    done
  fi
  # active pointer 갱신
  if [ -f "$ACTIVE_FILE" ] && [ "$(cat "$ACTIVE_FILE")" = "$SESSION" ]; then
    _set_active "$new_id"
  fi
  echo "[✓] renamed: $SESSION → $new_id"
}

cmd_list() {
  [ -d "$SESSIONS_DIR" ] || { echo "(no sessions)"; return 0; }
  local active=""
  [ -f "$ACTIVE_FILE" ] && active=$(cat "$ACTIVE_FILE")
  printf '%-28s %-10s %-22s %s\n' "NAME" "STATE" "CREATED" "TOPIC / PROJECT"
  printf '%-28s %-10s %-22s %s\n' "----------------------------" "----------" "----------------------" "----------------"
  local d
  for d in $(ls -1t "$SESSIONS_DIR" 2>/dev/null); do
    [ -f "$SESSIONS_DIR/$d/meta" ] || continue
    _load_meta "$SESSIONS_DIR/$d" 2>/dev/null || continue
    local state="-"
    if tmux has-session -t "$d" 2>/dev/null; then
      state="running"
    fi
    [ "$d" = "$active" ] && state="${state}*"
    local desc="${META_TOPIC:-}"
    [ -z "$desc" ] && desc="$META_PROJECT_DIR"
    printf '%-28s %-10s %-22s %s\n' "$d" "$state" "${META_CREATED:-?}" "$desc"
  done
  echo ""
  echo "(* = active default; running = tmux 세션 살아있음)"
}

cmd_show() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    name=$(_resolve_session 2>/dev/null) || { echo "[!] 활성 세션 없음 — 'debate show <name>'"; exit 1; }
  fi
  local dir="$SESSIONS_DIR/$name"
  [ -d "$dir" ] || { echo "[!] no session: $name"; exit 1; }
  _load_meta "$dir" || exit 1
  cat <<EOF
name:        $META_NAME
created:     $META_CREATED
project_dir: $META_PROJECT_DIR
topic:       $META_TOPIC
A:           $META_A_LABEL  ($META_A_SESSION_ID)
B:           $META_B_LABEL  ($META_B_SESSION_ID)
arbiter:     $META_ARBITER_LABEL  ($META_ARBITER_SESSION_ID)
EOF
  if [ -f "$dir/log.md" ]; then
    echo ""
    echo "── log.md (tail) ──"
    tail -n 20 "$dir/log.md"
  fi
}

# 내부: 메타로부터 토론 세션 띄우기 (resume / fork 공용)
_launch_from_meta() {
  local name="$1"; local fork="${2:-0}"; local include_arbiter="${3:-0}"; local override_dir="${4:-}"
  local dir="$SESSIONS_DIR/$name"
  _load_meta "$dir" || exit 1

  local project_dir="${override_dir:-$META_PROJECT_DIR}"
  if [ ! -d "$project_dir" ]; then
    echo "[!] project_dir 없음: $project_dir — 현재 디렉토리($(pwd)) 사용"
    project_dir="$(pwd)"
  elif [ "$project_dir" != "$META_PROJECT_DIR" ]; then
    echo "[!] project_dir 변경: $META_PROJECT_DIR → $project_dir"
  fi

  # resume 명령 빌드
  local a_cmd b_cmd arbiter_cmd
  a_cmd=$(_build_resume_cmd "$META_A_LABEL" "$META_A_SESSION_ID" "$fork")
  b_cmd=$(_build_resume_cmd "$META_B_LABEL" "$META_B_SESSION_ID" "$fork")

  # arbiter 는 기본 fresh
  local arb_label="$META_ARBITER_LABEL"
  local arb_sid=""
  if [ "$include_arbiter" = "1" ]; then
    arbiter_cmd=$(_build_resume_cmd "$arb_label" "$META_ARBITER_SESSION_ID" "$fork")
    arb_sid="$META_ARBITER_SESSION_ID"
  else
    arb_sid=$(_issue_session_id "$arb_label")
    arbiter_cmd=$(_build_start_cmd "$arb_label" "$arb_sid")
  fi

  local SESSION
  local new_a_sid="$META_A_SESSION_ID" new_b_sid="$META_B_SESSION_ID"

  if [ "$fork" = "1" ]; then
    # 새 dir 로 분기 (원본 보존)
    SESSION=$(_gen_session_id)
    if [ -d "$SESSIONS_DIR/$SESSION" ]; then SESSION=$(_gen_session_id); fi
    cp -r "$dir" "$SESSIONS_DIR/$SESSION"
    # cursor 는 새 chatId 발급 (claude 는 --fork-session 이 자동으로 새 id 부여)
    new_a_sid=""
    if [ "$META_B_LABEL" = "cursor" ]; then
      new_b_sid=$(agent create-chat 2>/dev/null)
      b_cmd="agent --resume $new_b_sid"
    fi
    META_NAME="$SESSION"
    META_PROJECT_DIR="$project_dir"
    META_A_SESSION_ID="$new_a_sid"
    META_B_SESSION_ID="$new_b_sid"
    META_ARBITER_SESSION_ID="$arb_sid"
    _save_meta "$SESSIONS_DIR/$SESSION"
  else
    # resume 은 같은 dir/세션 이름 그대로
    SESSION="$name"
    if tmux has-session -t "$SESSION" 2>/dev/null; then
      echo "[!] $SESSION 이 이미 실행 중입니다 — attach: tmux attach -t $SESSION"
      exit 1
    fi
    # arbiter 가 fresh 면 메타에 새 id 반영
    if [ "$include_arbiter" != "1" ]; then
      META_ARBITER_SESSION_ID="$arb_sid"
      _save_meta "$dir"
    fi
  fi

  _set_active "$SESSION"

  local tag=""
  [ "$fork" = "1" ] && tag=" (forked)"
  _setup_layout "$SESSION" "$project_dir" \
    "$META_A_LABEL$tag" "$a_cmd" \
    "$META_B_LABEL$tag" "$b_cmd" \
    "$arb_label" "$arbiter_cmd" \
    "MODERATOR — $SESSION (resumed: $name)"
  _log "resume" "session=$SESSION src=$name fork=$fork include_arbiter=$include_arbiter"
  tmux attach -t "$SESSION"
}

cmd_resume() {
  local name=""
  local include_arbiter=0
  local override_dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --include-arbiter) include_arbiter=1; shift ;;
      --in)              override_dir="$2"; shift 2 ;;
      *)                 name="$1"; shift ;;
    esac
  done
  [ -z "$name" ] && { echo "usage: debate resume <name> [--include-arbiter] [--in <dir>]"; exit 1; }
  _launch_from_meta "$name" 0 "$include_arbiter" "$override_dir"
}

cmd_fork() {
  local name=""
  local include_arbiter=0
  local override_dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --include-arbiter) include_arbiter=1; shift ;;
      --in)              override_dir="$2"; shift 2 ;;
      *)                 name="$1"; shift ;;
    esac
  done
  [ -z "$name" ] && { echo "usage: debate fork <name> [--include-arbiter] [--in <dir>]"; exit 1; }
  _launch_from_meta "$name" 1 "$include_arbiter" "$override_dir"
}

cmd_forget() {
  local name="${1:-}"
  [ -z "$name" ] && { echo "usage: debate forget <name>"; exit 1; }
  [ -d "$SESSIONS_DIR/$name" ] || { echo "[!] no session: $name"; exit 1; }
  if tmux has-session -t "$name" 2>/dev/null; then
    tmux kill-session -t "$name" 2>/dev/null || true
  fi
  rm -rf "$SESSIONS_DIR/$name"
  if [ -f "$ACTIVE_FILE" ] && [ "$(cat "$ACTIVE_FILE")" = "$name" ]; then
    rm -f "$ACTIVE_FILE"
  fi
  echo "[✓] forgotten: $name"
}

cmd_install_hooks() {
  local debate_path
  debate_path=$(command -v debate 2>/dev/null) || debate_path="$SELF"
  command -v python3 &>/dev/null || { echo "[!] python3 필요"; exit 1; }

  echo "[*] hook 설치 — debate 경로: $debate_path"

  # claude: ~/.claude/settings.json 의 Notification hook 추가
  python3 - "$debate_path" <<'PY'
import json, os, sys
debate_path = sys.argv[1]
path = os.path.expanduser("~/.claude/settings.json")
os.makedirs(os.path.dirname(path), exist_ok=True)
data = {}
if os.path.exists(path):
    try:
        with open(path) as f: data = json.load(f)
    except Exception: data = {}

hooks = data.setdefault("hooks", {})
notif = hooks.setdefault("Notification", [])
# 기존 debate-managed 제거
notif[:] = [e for e in notif if not any(
    "debate-managed" in (h.get("command", "") if isinstance(h, dict) else "")
    for h in (e.get("hooks", []) if isinstance(e, dict) else [])
)]
notif.append({
    "matcher": "permission_prompt|idle_prompt",
    "hooks": [{
        "type": "command",
        "command": f'{debate_path} _hook focus-self  # debate-managed'
    }]
})
# UserPromptSubmit → focus moderator (답변 후 자동 복귀)
ups = hooks.setdefault("UserPromptSubmit", [])
ups[:] = [e for e in ups if not any(
    "debate-managed" in (h.get("command", "") if isinstance(h, dict) else "")
    for h in (e.get("hooks", []) if isinstance(e, dict) else [])
)]
ups.append({
    "hooks": [{
        "type": "command",
        "command": f'{debate_path} _hook focus-moderator  # debate-managed'
    }]
})
# Stop → menu-maybe (menu-auto 켜져있으면 메뉴 팝업)
stop = hooks.setdefault("Stop", [])
stop[:] = [e for e in stop if not any(
    "debate-managed" in (h.get("command", "") if isinstance(h, dict) else "")
    for h in (e.get("hooks", []) if isinstance(e, dict) else [])
)]
stop.append({
    "hooks": [{
        "type": "command",
        "command": f'{debate_path} _hook menu-maybe  # debate-managed'
    }]
})

with open(path, "w") as f:
    json.dump(data, f, indent=2)
print(f"[✓] claude: {path}")
PY

  # cursor: ~/.cursor/hooks.json
  python3 - "$debate_path" <<'PY'
import json, os, sys
debate_path = sys.argv[1]
path = os.path.expanduser("~/.cursor/hooks.json")
os.makedirs(os.path.dirname(path), exist_ok=True)
data = {}
if os.path.exists(path):
    try:
        with open(path) as f: data = json.load(f)
    except Exception: data = {}

data.setdefault("version", 1)
hooks = data.setdefault("hooks", {})

def replace_managed(events):
    for ev in events:
        lst = hooks.setdefault(ev, [])
        lst[:] = [e for e in lst if "debate-managed" not in e.get("command", "")]

replace_managed(["stop", "beforeSubmitPrompt"])

# stop → menu-maybe (menu-auto 켜져있으면 메뉴, 아니면 no-op)
hooks.setdefault("stop", []).append({
    "command": f'{debate_path} _hook menu-maybe  # debate-managed'
})
hooks.setdefault("beforeSubmitPrompt", []).append({
    "command": f'{debate_path} _hook focus-moderator  # debate-managed'
})

with open(path, "w") as f:
    json.dump(data, f, indent=2)
print(f"[✓] cursor: {path}")
PY

  echo ""
  echo "동작:"
  echo "  - claude permission_prompt|idle_prompt → 그 pane focus (HITL)"
  echo "  - claude/cursor Stop → menu-auto 켜져있으면 moderator 에 메뉴 팝업"
  echo "  - 사용자가 답변 제출 시 → moderator pane 으로 자동 복귀"
  echo ""
  echo "menu 자동 트리거를 켜려면: debate menu-auto on"
}

cmd_uninstall_hooks() {
  command -v python3 &>/dev/null || { echo "[!] python3 필요"; exit 1; }

  python3 - <<'PY'
import json, os
for path in [os.path.expanduser("~/.claude/settings.json"),
             os.path.expanduser("~/.cursor/hooks.json")]:
    if not os.path.exists(path): continue
    try:
        with open(path) as f: data = json.load(f)
    except Exception: continue
    hooks = data.get("hooks", {})
    changed = False
    for ev, lst in list(hooks.items()):
        if not isinstance(lst, list): continue
        new_lst = []
        for e in lst:
            if isinstance(e, dict):
                inner = e.get("hooks", [])
                if any("debate-managed" in (h.get("command","") if isinstance(h,dict) else "") for h in inner):
                    changed = True; continue
                if "debate-managed" in e.get("command", ""):
                    changed = True; continue
            new_lst.append(e)
        if not new_lst:
            del hooks[ev]
            changed = True
        else:
            hooks[ev] = new_lst
    if changed:
        with open(path, "w") as f: json.dump(data, f, indent=2)
        print(f"[✓] cleaned: {path}")
    else:
        print(f"[-] no debate-managed entries: {path}")
PY
}

cmd_hooks_status() {
  command -v python3 &>/dev/null || { echo "[!] python3 필요"; exit 1; }
  python3 - <<'PY'
import json, os
for label, path in [("claude", "~/.claude/settings.json"),
                    ("cursor", "~/.cursor/hooks.json")]:
    p = os.path.expanduser(path)
    if not os.path.exists(p):
        print(f"[-] {label}: no settings file"); continue
    try:
        with open(p) as f: data = json.load(f)
    except Exception as e:
        print(f"[!] {label}: invalid json — {e}"); continue
    found = []
    def scan(lst, ev):
        for e in lst:
            if isinstance(e, dict):
                if "debate-managed" in e.get("command", ""):
                    found.append(ev)
                for h in e.get("hooks", []):
                    if isinstance(h, dict) and "debate-managed" in h.get("command", ""):
                        found.append(ev)
    for ev, lst in (data.get("hooks") or {}).items():
        if isinstance(lst, list): scan(lst, ev)
    if found:
        print(f"[✓] {label}: installed → {', '.join(found)}")
    else:
        print(f"[-] {label}: not installed")
PY
}

cmd_menu() {
  local SESSION
  SESSION=$(_resolve_session 2>/dev/null) || { echo "[!] 활성 세션 없음"; exit 1; }
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "[!] tmux 세션 없음: $SESSION"; exit 1
  fi

  local mod_pane
  mod_pane=$(tmux list-panes -t "$SESSION" -F '#{pane_id} #{pane_title}' 2>/dev/null \
    | awk '$2 ~ /^MODERATOR/ {print $1; exit}')
  [ -z "$mod_pane" ] && { echo "[!] moderator pane not found in $SESSION"; exit 1; }

  # display-menu 인자 빌드: -t target -T title 다음에 (label, key, command) 트리플 반복
  local args=( -t "$mod_pane" -T " debate menu " )

  _menu_add() {
    args+=( "$1" "$2" "send-keys -t $mod_pane \"$3\" Enter" )
  }
  _menu_sep() { args+=( "" ); }

  # 빌트인
  _menu_add "  1. relay     a → b  rebut       " 1 "debate relay a b rebut"
  _menu_add "  2. relay     b → a  rebut       " 2 "debate relay b a rebut"
  _menu_add "  3. relay-sum a → b  review      " 3 "debate relay-sum a b review"
  _menu_add "  4. relay-sum b → a  review      " 4 "debate relay-sum b a review"
  _menu_sep
  _menu_add "  5. round 2 review --sum         " 5 "debate round 2 review 20 --sum"
  _menu_add "  6. verdict                      " 6 "debate verdict"
  _menu_add "  7. shout 결론 정리              " 7 "debate shout 지금까지 토론을 종합해서 최종 결론과 수정 방안을 정리해"
  _menu_sep

  # 사용자 conf (~/.debate/menu.conf)
  local conf="$HOME/.debate/menu.conf"
  if [ -f "$conf" ]; then
    local i=8
    while IFS='|' read -r label cmd; do
      [ -z "$label" ] && continue
      case "$label" in \#*) continue ;; esac
      label="${label#"${label%%[![:space:]]*}"}"  # ltrim
      cmd="${cmd#"${cmd%%[![:space:]]*}"}"
      [ -z "$cmd" ] && continue
      _menu_add "$(printf '  %d. %s' "$i" "$label")" "$i" "$cmd"
      i=$((i+1))
    done < "$conf"
    _menu_sep
  fi

  _menu_add "  q. cancel                       " q ""

  tmux display-menu "${args[@]}"
}

cmd_menu_auto() {
  local arg="${1:-status}"
  local flag="$HOME/.debate/menu-auto"
  case "$arg" in
    on|enable)
      mkdir -p "$(dirname "$flag")"
      touch "$flag"
      echo "[✓] menu-auto: ON  (a/b/arbiter Stop hook 시 자동 메뉴 팝업)"
      ;;
    off|disable)
      rm -f "$flag"
      echo "[✓] menu-auto: OFF"
      ;;
    status)
      if [ -f "$flag" ]; then echo "menu-auto: ON"; else echo "menu-auto: OFF"; fi
      ;;
    *)
      echo "usage: debate menu-auto on|off|status"; exit 1
      ;;
  esac
}

cmd_focus() {
  local label="${1:-}"
  [ -z "$label" ] && { echo "usage: debate focus <a|b|arbiter|moderator>"; exit 1; }
  local SESSION
  SESSION=$(_resolve_session 2>/dev/null) || { echo "[!] 활성 세션 없음"; exit 1; }
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "[!] tmux 세션 없음: $SESSION"; exit 1
  fi
  # 해당 라벨 prefix 가 붙은 pane 의 pane_id 찾기
  local prefix
  case "$label" in
    a)         prefix="A:" ;;
    b)         prefix="B:" ;;
    arbiter|r) prefix="ARBITER" ;;
    moderator|m|mod) prefix="MODERATOR" ;;
    *) echo "[!] unknown label: $label"; exit 1 ;;
  esac
  local pid
  pid=$(tmux list-panes -t "$SESSION" -F '#{pane_id} #{pane_title}' 2>/dev/null \
    | awk -v p="$prefix" '$2 ~ ("^" p) {print $1; exit}')
  [ -z "$pid" ] && { echo "[!] $label pane not found"; exit 1; }
  tmux select-pane -t "$pid"
}

# 내부: hook 에서 호출. 현재 pane 에 focus 이동
cmd__hook() {
  local action="${1:-}"
  case "$action" in
    focus-self)
      [ -n "${TMUX_PANE:-}" ] && tmux select-pane -t "$TMUX_PANE" 2>/dev/null || true
      ;;
    focus-moderator)
      # 현재 tmux 세션의 MODERATOR pane 찾기
      local sess
      sess=$(tmux display-message -p '#{session_name}' 2>/dev/null) || return 0
      case "$sess" in debate-*) ;; *) return 0 ;; esac
      local pid
      pid=$(tmux list-panes -t "$sess" -F '#{pane_id} #{pane_title}' 2>/dev/null \
        | awk '$2 ~ /^MODERATOR/ {print $1; exit}')
      [ -n "$pid" ] && tmux select-pane -t "$pid" 2>/dev/null || true
      ;;
    menu-maybe)
      # menu-auto 가 켜져있을 때만 메뉴 팝업
      [ -f "$HOME/.debate/menu-auto" ] || return 0
      local sess
      sess=$(tmux display-message -p '#{session_name}' 2>/dev/null) || return 0
      case "$sess" in debate-*) ;; *) return 0 ;; esac
      DEBATE_SESSION="$sess" "$SELF" menu 2>/dev/null || true
      ;;
  esac
  # hook 표준 출력은 비움 (cursor 가 JSON 파싱 시도하므로 안전한 빈 라인)
  return 0
}

cmd_attach() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    name=$(_resolve_session 2>/dev/null) || { echo "[!] 활성 세션 없음 — 'debate attach <name>' 또는 'debate ls'"; exit 1; }
  fi
  if ! tmux has-session -t "$name" 2>/dev/null; then
    echo "[!] tmux 세션 없음: $name (resume 필요할 수 있음 → debate resume $name)"
    exit 1
  fi
  _set_active "$name"
  tmux attach -t "$name"
}

cmd_export() {
  local name="${1:-}"; local out="${2:-}"
  [ -z "$name" ] || [ -z "$out" ] && { echo "usage: debate export <name> <out.tar.gz>"; exit 1; }
  [ -d "$SESSIONS_DIR/$name" ] || { echo "[!] no session: $name"; exit 1; }
  tar -czf "$out" -C "$SESSIONS_DIR" "$name"
  echo "[✓] exported: $out"
}

cmd_tell() {
  local target="$1"; shift
  _send "$target" "$*"
  _log "tell → $target" "$*"
}

cmd_hear() {
  local target="${1:-claude}"
  local lines="${2:-30}"
  local out
  out=$(tmux-bridge read "$target" "$lines")
  echo "$out"
  _log "hear ← $target ($lines lines)" "$out"
}

cmd_relay() {
  local from="$1"; local to="$2"
  local mode="${3:-rebut}"
  local lines=30
  local append=""
  # 4번째: 숫자면 lines, 아니면 append text
  if [ -n "${4:-}" ]; then
    if [[ "$4" =~ ^[0-9]+$ ]]; then
      lines="$4"
      [ -n "${5:-}" ] && append="$5"
    else
      append="$4"
    fi
  fi
  local content prompt
  content=$(tmux-bridge read "$from" "$lines")
  prompt=$(_prompt "$mode" "$from" "$content")
  if [ -n "$append" ]; then
    prompt="${prompt}"$'\n'"${append}"
  fi
  _send "$to" "$prompt"
  _log "relay[$mode] $from → $to" "$prompt"
}

# 독립 세션에서 요약 (stateless headless 호출 — 토론 컨텍스트 오염 없음)
_summarize_iso() {
  local content="$1"
  local cli="${DEBATE_SUMMARIZER:-claude}"
  local prompt="다음은 어느 토론자 pane 의 출력이다. 핵심 주장과 근거만 5~7줄로 요약해줘. 요약만 출력하고 다른 말은 하지 마.

$content"
  case "$cli" in
    claude)
      claude --print --no-session-persistence -p "$prompt" 2>/dev/null
      ;;
    cursor)
      agent --print "$prompt" 2>/dev/null
      ;;
    *)
      echo "[!] unknown DEBATE_SUMMARIZER: $cli" >&2
      return 1
      ;;
  esac
}

cmd_relay_sum() {
  # --inplace 플래그 추출 (옛 동작: 화자에게 직접 요약시킴)
  local inplace=0
  local pos=()
  for a in "$@"; do
    case "$a" in
      --inplace) inplace=1 ;;
      *) pos+=("$a") ;;
    esac
  done
  set -- "${pos[@]}"

  local from="$1"; local to="$2"
  local mode="${3:-rebut}"
  local num=""
  local append=""
  if [ -n "${4:-}" ]; then
    if [[ "$4" =~ ^[0-9]+$ ]]; then
      num="$4"
      [ -n "${5:-}" ] && append="$5"
    else
      append="$4"
    fi
  fi

  local summary
  if [ "$inplace" = "1" ]; then
    # 옛 동작: 화자에게 자기 주장 요약시키고 캡처
    local wait_sec="${num:-10}"
    echo "[*] [inplace] $from 에게 요약 요청 (대기 ${wait_sec}s)..."
    _send "$from" "지금까지 너의 주장과 근거를 핵심만 5~7줄로 요약해줘. 요약만 출력해."
    sleep "$wait_sec"
    summary=$(tmux-bridge read "$from" 80)
  else
    # 기본: iso — pane 출력 캡처해서 독립 stateless 세션에 요약시킴
    local lines="${num:-200}"
    local cli="${DEBATE_SUMMARIZER:-claude}"
    echo "[*] [iso/$cli] $from pane $lines 줄 캡처 → 독립 세션 요약..."
    local content
    content=$(tmux-bridge read "$from" "$lines")
    summary=$(_summarize_iso "$content")
    if [ -z "$summary" ]; then
      echo "[!] 요약 실패 (DEBATE_SUMMARIZER=$cli, 또는 --inplace 시도)"
      exit 1
    fi
  fi

  local prompt
  prompt=$(_prompt "$mode" "$from" "$summary")
  if [ -n "$append" ]; then
    prompt="${prompt}"$'\n'"${append}"
  fi
  _send "$to" "$prompt"
  local tag="iso"; [ "$inplace" = "1" ] && tag="inplace"
  _log "relay-sum[$mode/$tag] $from → $to" "$prompt"
  echo "[✓] 요약 전달 완료"
}

cmd_round() {
  local n="${1:-3}"
  local mode="${2:-rebut}"
  local wait_sec="${3:-15}"
  local sum_flag="${4:-}"
  local sub="relay"
  [ "$sum_flag" = "--sum" ] && sub="relay-sum"
  local i
  for ((i=1; i<=n; i++)); do
    echo "── round $i/$n  (a → b, $mode) ──"
    "$SELF" "$sub" a b "$mode"
    sleep "$wait_sec"
    echo "── round $i/$n  (b → a, $mode) ──"
    "$SELF" "$sub" b a "$mode"
    sleep "$wait_sec"
  done
  echo "[✓] $n 라운드 종료"
  _log "round done" "n=$n mode=$mode sum=$sum_flag"
}

cmd_shout() {
  local include_arbiter=0
  if [ "${1:-}" = "--all" ]; then include_arbiter=1; shift; fi
  _send a "$*"
  _send b "$*"
  if [ $include_arbiter -eq 1 ]; then
    _send arbiter "$*"
    _log "shout --all → a+b+arbiter" "$*"
  else
    _log "shout → a+b" "$*"
  fi
}

# verdict [lines] — a/b 의 최근 출력을 모아 arbiter 에 판정 요청
cmd_verdict() {
  local lines="${1:-40}"
  local a_out b_out prompt
  a_out=$(tmux-bridge read a "$lines")
  b_out=$(tmux-bridge read b "$lines")
  prompt=$(printf '두 토론자(A, B)의 주장이다. 중립적으로 판정하고, 더 설득력 있는 쪽과 그 이유, 그리고 양쪽이 놓친 점을 정리해.\n\n=== A ===\n%s\n\n=== B ===\n%s' "$a_out" "$b_out")
  _send arbiter "$prompt"
  _log "verdict → arbiter (lines=$lines)" "$prompt"
  echo "[✓] arbiter 에 판정 요청 전송"
}

cmd_pick() {
  local from="$1"; local to="$2"
  local modes=(rebut review agree extend question judge)
  local mode
  if command -v fzf &>/dev/null; then
    mode=$(printf '%s\n' "${modes[@]}" | fzf --prompt="relay mode> " --height=10)
  else
    PS3="mode 선택: "
    select mode in "${modes[@]}"; do [ -n "$mode" ] && break; done
  fi
  [ -z "$mode" ] && { echo "취소"; return 1; }
  cmd_relay "$from" "$to" "$mode"
}

cmd_log() {
  case "${1:-}" in
    path)  echo "$DEBATE_LOG" ;;
    tail)  tail -n "${2:-50}" "$DEBATE_LOG" ;;
    clear) : > "$DEBATE_LOG"; echo "cleared: $DEBATE_LOG" ;;
    "")    ${EDITOR:-less} "$DEBATE_LOG" ;;
    *)     echo "usage: debate log [path|tail [N]|clear]"; exit 1 ;;
  esac
}

cmd_doctor() {
  local ok=1
  for c in tmux tmux-bridge claude python3; do
    if command -v "$c" &>/dev/null; then echo "[✓] $c"; else echo "[✗] $c"; ok=0; fi
  done
  if command -v agent &>/dev/null || command -v cursor-agent &>/dev/null; then
    echo "[✓] cursor agent"
  else
    echo "[✗] cursor agent"; ok=0
  fi
  echo ""
  echo "── HITL focus hooks ──"
  cmd_hooks_status 2>/dev/null || echo "(hooks-status check failed)"
  echo ""
  echo "log:      $DEBATE_LOG"
  echo "sessions: $SESSIONS_DIR"
  echo "active:   $([ -f "$ACTIVE_FILE" ] && cat "$ACTIVE_FILE" || echo '(none)')"
  [ $ok -eq 1 ] || exit 1
}

usage() {
cat <<EOF
debate — Claude Code × Cursor Agent debate CLI

역할 (pane label):
  a, b              debater — 토론자 (각각 claude/cursor 등 자유 선택)
  arbiter           중재자/판정자
  moderator         사용자 (이 CLI 를 실행하는 진행자 pane)

세션 관리:
  debate start [--name <n>] [--a claude|cursor] [--b ...] [--arbiter ...] [--topic <text>] [dir]
                                        4-pane 토론 세션 시작
                                        세션 id 자동 생성 (debate-<8자리>),
                                        --name 지정 시 debate-<name>
  debate stop [name]                    세션 종료 (dir 은 보존)
  debate attach [name]                  실행 중인 세션에 attach
  debate focus <a|b|arbiter|moderator>  활성 세션의 특정 pane 으로 focus 이동
  debate doctor                         의존성 + hooks 점검

HITL focus hooks:
  debate install-hooks                  claude/cursor 의 hook 설치
                                        - permission/idle 시 pane focus
                                        - Stop 시 (menu-auto on) 메뉴 팝업
  debate uninstall-hooks                hook 제거
  debate hooks-status                   설치 상태 확인

메뉴 (자주 쓰는 명령 빠른 실행):
  debate menu                           moderator 에 tmux display-menu 팝업
                                        화살표/숫자로 선택 → 명령 자동 실행
  debate menu-auto on|off|status        a/b Stop 시 자동 팝업 토글
  사용자 정의 항목: ~/.debate/menu.conf
                                        형식: 라벨|debate command (line 단위)
                                        예:    review round 3|debate round 3 review

키바인딩 (debate start 시 자동 등록, prefix = Ctrl-b):
  prefix + a/b/r/m   → A/B/arbiter/moderator pane 으로 focus 이동

세션 저장/복원:
  debate save <new-name>                활성 세션을 debate-<new-name> 으로 rename
  debate list (= ls)                    모든 세션 목록 ([running] / active 표시)
  debate show [name]                    세션 메타데이터 + 로그 미리보기
  debate resume <name> [--include-arbiter] [--in <dir>]
                                        저장된 세션 복원 (native --resume)
  debate fork <name> [--include-arbiter] [--in <dir>]
                                        세션을 새 dir 로 분기 (claude --fork-session)
  debate forget <name> (= rm)           세션 삭제 (running 이면 같이 kill)
  debate export <name> <out.tar.gz>     세션 tarball 로 내보내기

다중 세션:
  여러 debate 를 동시 실행 가능. 각 세션은 고유 id (debate-<uuid>) 로 격리.
  moderator pane 안에서 친 명령은 자동으로 그 세션을 대상으로 함.
  외부에서는 ~/.debate/active 의 마지막 세션이 기본값.
  명시 지정: DEBATE_SESSION=debate-7f3a1b2c debate hear a

대화:
  debate tell <target> <msg>            target (a|b|arbiter) 에 메시지 입력 + Enter
  debate hear <target> [lines]          target pane 출력 캡처 (기본 30줄)
  debate shout [--all] <msg>            양쪽 토론자 동시 지시 (--all: arbiter 포함)
  debate verdict [lines]                a+b 출력을 모아 arbiter 에 판정 요청

릴레이 (mode: rebut|review|agree|extend|question|judge):
  debate relay <from> <to> [mode] [lines] ["추가 지시"]
                                        4번째가 숫자면 lines, 아니면 prompt 뒤에 append
  debate relay-sum <from> <to> [mode] [lines] ["추가 지시"] [--inplace]
                                        기본: 독립 stateless 세션 (claude --print) 으로 요약
                                              → 화자 컨텍스트 오염 없음
                                        --inplace: 옛 동작 (화자 본인에게 요약시킴, 4번째=wait_sec)
                                        DEBATE_SUMMARIZER=claude|cursor 로 요약 CLI 변경
  debate pick <from> <to>               mode 를 메뉴(fzf/select)로 선택 후 relay
  debate round N [mode] [wait_sec] [--sum]
                                        N 라운드 양방향 자동 릴레이

로그:
  debate log                            \$EDITOR/less 로 로그 열기
  debate log tail [N]                   최근 N줄
  debate log path                       로그 파일 경로
  debate log clear                      로그 비우기

환경변수:
  DEBATE_LOG           로그 파일 경로 (기본 ~/.debate/log-YYYYMMDD.md)
  DEBATE_SESSION       tmux 세션 이름 강제 지정 (대부분 자동 결정됨)
  DEBATE_A_CMD         A pane 기본 CLI (기본 claude)
  DEBATE_B_CMD         B pane 기본 CLI (기본 cursor)
  DEBATE_ARBITER_CMD   arbiter pane 기본 CLI (기본 claude)
  DEBATE_SESSIONS_DIR  세션 저장 디렉토리 (기본 ~/.debate/sessions)
  DEBATE_AUTO_KEEP     자동 보존 세션 최대 개수 (기본 10)
  DEBATE_SUMMARIZER    relay-sum 의 독립 요약기 (claude|cursor, 기본 claude)

target: a | b | arbiter | moderator (start 시 자동 라벨링).
EOF
}

# ─── dispatch ───────────────────────────────────────────

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  start)              cmd_start "$@" ;;
  stop|kill)          cmd_stop "$@" ;;
  attach)             cmd_attach "$@" ;;
  focus)              cmd_focus "$@" ;;
  menu)               cmd_menu "$@" ;;
  menu-auto)          cmd_menu_auto "$@" ;;
  install-hooks)      cmd_install_hooks "$@" ;;
  uninstall-hooks)    cmd_uninstall_hooks "$@" ;;
  hooks-status)       cmd_hooks_status "$@" ;;
  _hook)              cmd__hook "$@" ;;
  doctor)             cmd_doctor ;;
  tell)               cmd_tell "$@" ;;
  hear)               cmd_hear "$@" ;;
  relay)              cmd_relay "$@" ;;
  relay-sum)          cmd_relay_sum "$@" ;;
  round)              cmd_round "$@" ;;
  shout)              cmd_shout "$@" ;;
  verdict)            cmd_verdict "$@" ;;
  pick)               cmd_pick "$@" ;;
  save)               cmd_save "$@" ;;
  list|ls)            cmd_list "$@" ;;
  show)               cmd_show "$@" ;;
  resume)             cmd_resume "$@" ;;
  fork)               cmd_fork "$@" ;;
  forget|rm)          cmd_forget "$@" ;;
  export)             cmd_export "$@" ;;
  log)                cmd_log "$@" ;;
  ""|help|-h|--help)  usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
